[Unit]
Description=gatehub fingerprint gate control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ gatehub_user }}
Group={{ gatehub_group }}
EnvironmentFile={{ gatehub_config_dir }}/gatehub.env
ExecStart={{ gatehub_binary }} \
  --db=${GATEHUB_DB} \
  --admin-listen=${GATEHUB_ADMIN_LISTEN} \
  --admin-auth=${GATEHUB_ADMIN_AUTH} \
  --admin-oidc-issuer=${GATEHUB_ADMIN_OIDC_ISSUER} \
  --admin-oidc-client-id=${GATEHUB_ADMIN_OIDC_CLIENT_ID} \
  --admin-oidc-redirect-url=${GATEHUB_ADMIN_OIDC_REDIRECT_URL} \
  --admin-oidc-allowed-emails=${GATEHUB_ADMIN_OIDC_ALLOWED_EMAILS} \
  --public-listen=${GATEHUB_PUBLIC_LISTEN} \
  --public-auth=${GATEHUB_PUBLIC_AUTH} \
  --public-cert=${GATEHUB_PUBLIC_CERT} \
  --public-key=${GATEHUB_PUBLIC_KEY} \
  --client-ca=${GATEHUB_CLIENT_CA} \
  --client-crl=${GATEHUB_CLIENT_CRL} \
  --sighting-retention=${GATEHUB_SIGHTING_RETENTION} \
  --web-shadow-enabled=${GATEHUB_WEB_SHADOW_ENABLED} \
  --web-shadow-min-networks=${GATEHUB_WEB_SHADOW_MIN_NETWORKS} \
  --web-shadow-min-signals=${GATEHUB_WEB_SHADOW_MIN_SIGNALS} \
  --web-shadow-min-error-ratio=${GATEHUB_WEB_SHADOW_MIN_ERROR_RATIO} \
  --web-shadow-require-multi-scope=${GATEHUB_WEB_SHADOW_REQUIRE_MULTI_SCOPE} \
  --web-shadow-proposed-ttl=${GATEHUB_WEB_SHADOW_PROPOSED_TTL} \
  --trusted-home-ipv4-urls=${GATEHUB_TRUSTED_HOME_IPV4_URLS} \
  --trusted-home-ipv6-prefix=${GATEHUB_TRUSTED_HOME_IPV6_PREFIX} \
  --trusted-dns-names=${GATEHUB_TRUSTED_DNS_NAMES} \
  --trusted-source-refresh=${GATEHUB_TRUSTED_SOURCE_REFRESH} \
  --trusted-source-grace=${GATEHUB_TRUSTED_SOURCE_GRACE}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ gatehub_data_dir }}
ReadOnlyPaths={{ gatehub_config_dir }}

[Install]
WantedBy=multi-user.target
